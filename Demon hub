--[[
    Demon Hub - Interface Assassina
    Deleta o visual do Lirp e mantém o motor rodando.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. CARREGA O LIRP
pcall(function()
    loadstring(game:HttpGet("https://lirp.mrbrainas.workers.dev/Loader", true))()
end)

print("Aguardando Lirp carregar... Se a tela de Key aparecer, preencha.")
task.wait(12) -- Tempo para você colocar a Key do Lirp caso ele peça

-- 2. ASSASSINATO VISUAL DO LIRP
-- Vamos varrer a tela e deletar tudo que for do Lirp, menos o Demon Hub
for _, gui in pairs(PlayerGui:GetChildren()) do
    if (gui:IsA("ScreenGui") or gui:IsA("GuiMain")) and gui.Name ~= "DemonHub" then
        -- Deleta a interface do Lirp, mas isso não para os scripts dele que já estão na memória
        pcall(function()
            gui:Destroy()
        end)
    end
end

-- 3. CRIA A INTERFACE DO DEMON HUB
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DemonHub"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 99999
ScreenGui.Parent = PlayerGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 600, 0, 400)
MainFrame.Position = UDim2.new(0.5, -300, 0.5, -200)
MainFrame.BackgroundColor3 = Color3.fromRGB(12, 10, 12)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local mainCorner = Instance.new("UICorner"); mainCorner.CornerRadius = UDim.new(0, 8); mainCorner.Parent = MainFrame
local mainStroke = Instance.new("UIStroke"); mainStroke.Color = Color3.fromRGB(255, 30, 50); mainStroke.Thickness = 1.5; mainStroke.Parent = MainFrame

-- Cabeçalho
local Header = Instance.new("Frame")
Header.Size = UDim2.new(1, 0, 0, 50)
Header.BackgroundColor3 = Color3.fromRGB(20, 10, 12)
Header.Parent = MainFrame
local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(0, 8); hc.Parent = Header

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, -60, 1, 0); Title.Position = UDim2.new(0, 20, 0, 0)
Title.BackgroundTransparency = 1; Title.Text = "Demon Hub | PROJECT DELTA"
Title.TextColor3 = Color3.fromRGB(255, 30, 50); Title.TextSize = 18
Title.Font = Enum.Font.GothamBold; Title.TextXAlignment = Enum.TextXAlignment.Left; Title.Parent = Header

local CloseBtn = Instance.new("TextButton")
