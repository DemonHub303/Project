-- ESP Store
local ESPStore = {}

local function CreateESP(plr)
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    -- Billboard (Nome, Distância, Vida)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DemonESP"; billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0); billboard.AlwaysOnTop = true
    billboard.Enabled = false; billboard.Parent = head

    local mainFrame = Instance.new("Frame"); mainFrame.Size = UDim2.new(1, 0, 1, 0); mainFrame.BackgroundTransparency = 1; mainFrame.Parent = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"; nameLabel.Size = UDim2.new(1, 0, 0, 15); nameLabel.Position = UDim2.new(0, 0, 0, -15)
    nameLabel.BackgroundTransparency = 1; nameLabel.Text = plr.Name; nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = Config.textSize; nameLabel.Font = Enum.Font.GothamBold; nameLabel.TextStrokeTransparency = 0; nameLabel.Visible = false; nameLabel.Parent = mainFrame

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "DistLabel"; distLabel.Size = UDim2.new(1, 0, 0, 15); distLabel.Position = UDim2.new(0, 0, 1, 2)
    distLabel.BackgroundTransparency = 1; distLabel.TextColor3 = Config.colorTheme; distLabel.TextSize = Config.textSize
    distLabel.Font = Enum.Font.GothamBold; distLabel.TextStrokeTransparency = 0; distLabel.Visible = false; distLabel.Parent = mainFrame

    local healthBar = Instance.new("Frame")
    healthBar.Name = "HealthBar"; healthBar.Size = UDim2.new(0, 4, 1, 0); healthBar.Position = UDim2.new(1, 5, 0, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0); healthBar.BorderSizePixel = 0; healthBar.Visible = false; healthBar.Parent = mainFrame

    -- Tracer
    local tracerLine = Instance.new("LineHandleAdornment")
    tracerLine.Name = "Tracer"; tracerLine.Adornee = head; tracerLine.Thickness = 1.5
    tracerLine.Color3 = Config.colorTheme; tracerLine.Transparency = 0.4; tracerLine.AlwaysOnTop = true
    tracerLine.Visible = false; tracerLine.Parent = head

    -- Highlight (Box ESP nativo, super leve)
    local highlight = Instance.new("Highlight")
    highlight.Name = "DemonBox"; highlight.Adornee = char
    highlight.FillTransparency = 1; highlight.OutlineColor = Config.colorTheme
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false; highlight.Parent = char

    ESPStore[plr] = { 
        Billboard = billboard, Name = nameLabel, Dist = distLabel, 
        Health = healthBar, Tracer = tracerLine, Highlight = highlight, Head = head 
    }
end

local function RemoveESP(plr)
    if ESPStore[plr] then
        if ESPStore[plr].Billboard then ESPStore[plr].Billboard:Destroy() end
        if ESPStore[plr].Tracer then ESPStore[plr].Tracer:Destroy() end
        if ESPStore[plr].Highlight then ESPStore[plr].Highlight:Destroy() end
        ESPStore[plr] = nil
    end
end

-- Loop Principal
RunService.RenderStepped:Connect(function()
    if not MainGui.Parent then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    -- Aimbot Logic
    if aiming and Config.aimbotEnabled and myRoot and Camera then
        local closestPlr, closestDist = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                if Config.teamCheck and plr.Team == LocalPlayer.Team then continue end
                local head = plr.Character.Head
                local dist = (Camera.CFrame.Position - head.Position).Magnitude
                if dist < Config.aimbotRadius and dist < closestDist and IsVisible(head) then
                    closestDist = dist; closestPlr = head
                end
            end
        end
        if closestPlr then
            local smooth = Config.aimbotSmoothness / 10
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, closestPlr.Position), smooth)
        end
    end

    -- ESP Logic
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or (Config.teamCheck and plr.Team == LocalPlayer.Team) then continue end
        
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if not char or not hum or hum.Health <= 0 or not head or not root then
            RemoveESP(plr); continue
        end
        
        if not ESPStore[plr] or ESPStore[plr].Billboard.Parent ~= head then
            RemoveESP(plr); CreateESP(plr)
        end
        
        local data = ESPStore[plr]
        if data then
            local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
            local plrIsAdmin = Config.adminESP and isAdmin(plr)
            local plrIsCheater = Config.cheaterESP and isCheater(plr)
            
            -- Atualiza Cores
            local currentColor = plrIsAdmin and Config.adminColor or (plrIsCheater and Config.cheaterColor or Config.colorTheme)
            
            data.Highlight.Enabled = Config.boxESP or plrIsAdmin or plrIsCheater
            data.Highlight.OutlineColor = currentColor
            
            data.Billboard.Enabled = Config.nameTagESP or Config.distanceESP or Config.healthBarESP or plrIsAdmin or plrIsCheater
            
            if data.Billboard.Enabled then
                data.Name.Visible = Config.nameTagESP or plrIsAdmin or plrIsCheater
                if plrIsAdmin then
                    data.Name.Text = "[ADMIN] " .. plr.Name; data.Name.TextColor3 = Config.adminColor
                elseif plrIsCheater then
                    data.Name.Text = "[CHEATER] " .. plr.Name; data.Name.TextColor3 = Config.cheaterColor
                else
                    data.Name.Text = plr.Name; data.Name.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
                
                data.Dist.Visible = Config.distanceESP
                data.Dist.Text = "[" .. dist .. "m]"
                
                data.Health.Visible = Config.healthBarESP
                local hpPct = hum.Health / hum.MaxHealth
                data.Health.Size = UDim2.new(0, 4, hpPct, 0)
                data.Health.Position = UDim2.new(1, 5, 1 - hpPct, 0)
                data.Health.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0)
            end

            -- Tracer
            data.Tracer.Visible = Config.tracerESP or plrIsAdmin or plrIsCheater
            if data.Tracer.Visible and myRoot then
                data.Tracer.Offset = myRoot.CFrame:PointToObjectSpace(myRoot.Position) 
                data.Tracer.Color3 = currentColor
            end
        end
    end
end)

