local function EstaVisivel(parteAlvo)
    if not Config.checarVisivel then return true end
    local parametrosRaio = RaycastParams.new()
    parametrosRaio.FilterDescendantsInstances = {JogadorLocal.Character, parteAlvo.Parent}
    parametrosRaio.FilterType = Enum.RaycastFilterType.Exclude
    local origem = Camera.CFrame.Position
    local direcao = (parteAlvo.Position - origem)
    local resultado = workspace:Raycast(origem, direcao, parametrosRaio)
    return resultado == nil
end

local mirando = false
ServicoEntrada.InputBegan:Connect(function(input, processadoPeloJogo)
    if processadoPeloJogo then return end
    if (input.KeyCode == Config.teclaAimbot or input.UserInputType == Config.teclaAimbot) and Config.aimbotAtivo then 
        mirando = true 
    end
end)

ServicoEntrada.InputEnded:Connect(function(input, processadoPeloJogo)
    if (input.KeyCode == Config.teclaAimbot or input.UserInputType == Config.teclaAimbot) then 
        mirando = false 
        ServicoEntrada.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

local ArmazemESP = {}

local function CriarESP(jogador)
