    local cabeca = personagem:FindFirstChild("Head")
    if not cabeca then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DemonESP"; billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0); billboard.AlwaysOnTop = true
    billboard.Enabled = false; billboard.Parent = cabeca

    local quadroPrincipal = Instance.new("Frame"); quadroPrincipal.Size = UDim2.new(1, 0, 1, 0); quadroPrincipal.BackgroundTransparency = 1; quadroPrincipal.Parent = billboard

    local labelNome = Instance.new("TextLabel")
    labelNome.Name = "LabelNome"; labelNome.Size = UDim2.new(1, 0, 0, 15); labelNome.Position = UDim2.new(0, 0, 0, -15)
    labelNome.BackgroundTransparency = 1; labelNome.Text = jogador.Name; labelNome.TextColor3 = Color3.fromRGB(255, 255, 255)
    labelNome.TextSize = Config.tamanhoTextoESP; labelNome.Font = Enum.Font.GothamBold; labelNome.TextStrokeTransparency = 0; labelNome.Visible = false; labelNome.Parent = quadroPrincipal

    local labelDistancia = Instance.new("TextLabel")
    labelDistancia.Name = "LabelDistancia"; labelDistancia.Size = UDim2.new(1, 0, 0, 15); labelDistancia.Position = UDim2.new(0, 0, 1, 2)
    labelDistancia.BackgroundTransparency = 1; labelDistancia.TextColor3 = Config.corTema; labelDistancia.TextSize = Config.tamanhoTextoESP
    labelDistancia.Font = Enum.Font.GothamBold; labelDistancia.TextStrokeTransparency = 0; labelDistancia.Visible = false; labelDistancia.Parent = quadroPrincipal

    local barraVida = Instance.new("Frame")
    barraVida.Name = "BarraVida"; barraVida.Size = UDim2.new(0, 4, 1, 0); barraVida.Position = UDim2.new(1, 5, 0, 0)
    barraVida.BackgroundColor3 = Color3.fromRGB(0, 255, 0); barraVida.BorderSizePixel = 0; barraVida.Visible = false; barraVida.Parent = quadroPrincipal

    ArmazemESP[jogador] = { Billboard = billboard, Nome = labelNome, Distancia = labelDistancia, Vida = barraVida, Personagem = personagem, Partes = {} }
end

local function RemoverESP(jogador)
    if ArmazemESP[jogador] then
        if ArmazemESP[jogador].Billboard then ArmazemESP[jogador].Billboard:Destroy() end
        for _, parte in pairs(ArmazemESP[jogador].Partes) do
            if parte and parte:IsA("BasePart") then parte.Color = Color3.new(1, 1, 1) end
        end
        ArmazemESP[jogador] = nil
    end
end

ExecutarServico.RenderStepped:Connect(function()
    if not InterfacePrincipal.Parent then return end
    local meuPersonagem = JogadorLocal.Character
    local meuRoot = meuPersonagem and meuPersonagem:FindFirstChild("HumanoidRootPart")
    
    -- Lógica do Aimbot
    if mirando and Config.aimbotAtivo and meuRoot and Camera then
        local jogadorMaisProximo, distanciaMaisProxima = nil, math.huge
        for _, jogador in ipairs(Jogadores:GetPlayers()) do
            if jogador ~= JogadorLocal and jogador.Character and jogador.Character:FindFirstChild("Head") then
                local cabeca = jogador.Character.Head
                local distancia = (Camera.CFrame.Position - cabeca.Position).Magnitude
                if distancia < Config.aimbotRaio and distancia < distanciaMaisProxima and EstaVisivel(cabeca) then
                    distanciaMaisProxima = distancia; jogadorMaisProximo = cabeca
                end
            end
        end
        if jogadorMaisProximo then
            local pontoTela = Camera:WorldToViewportPoint(jogadorMaisProximo.Position)
            if pontoTela.Z > 0 then
                ServicoEntrada.MouseBehavior = Enum.MouseBehavior.LockCenter
                mousemoverel((pontoTela.X - Camera.ViewportSize.X/2) * (Config.aimbotSuavidade / 10), (pontoTela.Y - Camera.ViewportSize.Y/2) * (Config.aimbotSuavidade / 10))
            end
        end
    end

    -- Lógica do ESP
    for _, jogador in ipairs(Jogadores:GetPlayers()) do
        if jogador == JogadorLocal or (Config.checarTime and jogador.Team == JogadorLocal.Team) then continue end
        local personagem = jogador.Character
        local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
        local cabeca = personagem and personagem:FindFirstChild("Head")
        local root = personagem and personagem:FindFirstChild("HumanoidRootPart")
        
        if not personagem or not humanoid or humanoid.Health <= 0 or not cabeca or not root then
            RemoverESP(jogador); continue
        end
        
        if not ArmazemESP[jogador] or ArmazemESP[jogador].Personagem ~= personagem then
            RemoverESP(jogador); CriarESP(jogador)
        end
        
        local dados = ArmazemESP[jogador]
        if dados then
            local distancia = meuRoot and math.floor((meuRoot.Position - root.Position).Magnitude) or 0
            if distancia > Config.distanciaMax then dados.Billboard.Enabled = false; continue end
            
            dados.Billboard.Enabled = Config.nomeESP or Config.distanciaESP or Config.barraVidaESP
            if dados.Billboard.Enabled then
                dados.Nome.Visible = Config.nomeESP
                dados.Nome.Text = jogador.Name
                dados.Distancia.Visible = Config.distanciaESP
                dados.Distancia.Text = "[" .. distancia .. "m]"
                dados.Vida.Visible = Config.barraVidaESP
                local porcentagemVida = humanoid.Health / humanoid.MaxHealth
                dados.Vida.Size = UDim2.new(0, 4, porcentagemVida, 0)
                dados.Vida.Position = UDim2.new(1, 5, 1 - porcentagemVida, 0)
                dados.Vida.BackgroundColor3 = Color3.fromRGB(255 * (1 - porcentagemVida), 255 * porcentagemVida, 0)
            end

            if Config.caixaESP then
                for _, parte in ipairs(personagem:GetChildren()) do
                    if parte:IsA("BasePart") and parte.Name ~= "HumanoidRootPart" then
                        parte.Color = Config.corTema
                        table.insert(dados.Partes, parte)
                    end
                end
            end
