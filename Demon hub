-- Sistema de Salvar/Carregar Seguro para Xeno
local function SalvarConfig(nomeSlot)
    if not writefile then return end
    local nomeArquivo = "demonhub_" .. tostring(nomeSlot) .. ".json"
    local dadosSalvar = {}
    for k, v in pairs(Config) do
        if typeof(v) == "Color3" then
            dadosSalvar[k] = {r = v.R, g = v.G, b = v.B, ehCor = true}
        elseif typeof(v) == "EnumItem" then
            dadosSalvar[k] = {nome = v.Name, ehEnum = true}
        else
            dadosSalvar[k] = v
        end
    end
    pcall(function() writefile(nomeArquivo, ServicoHttp:JSONEncode(dadosSalvar)) end)
end

local function CarregarConfig(nomeSlot)
    if not readfile or not isfile then return end
    local nomeArquivo = "demonhub_" .. tostring(nomeSlot) .. ".json"
    if isfile(nomeArquivo) then
        pcall(function()
            local dados = ServicoHttp:JSONDecode(readfile(nomeArquivo))
            for k, v in pairs(dados) do
                if type(v) == "table" and v.ehCor then
                    Config[k] = Color3.new(v.r, v.g, v.b)
                elseif type(v) == "table" and v.ehEnum then
                    Config[k] = Enum.UserInputType[v.nome] or Enum.KeyCode[v.nome]
                else
                    Config[k] = v
                end
            end
        end)
    end
end

